# ── Database / cache ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flighthotel
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/flighthotel
REDIS_URL=redis://localhost:6379

# ── Auth (Auth.js v5) ──
AUTH_SECRET=                       # openssl rand -base64 32
# AUTH_URL=http://localhost:3000   # only needed behind a proxy; trustHost infers it otherwise
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DEV_LOGIN=true                # dev-only email login without a mail provider

# ── Flights + hotels (Amadeus) ──
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_MAX_RPS=8
FLIGHT_CACHE_TTL_SEC=480
HOTEL_CACHE_TTL_SEC=600
DEFAULT_CURRENCY=USD

# ── Tracking (FlightAware AeroAPI). Leave empty to use the built-in mock provider ──
FLIGHTAWARE_API_KEY=
TRACKING_PROVIDER=mock             # mock | flightaware

# ── Email (Resend) ──
RESEND_API_KEY=
EMAIL_FROM="Flight Hotel <trips@example.com>"
RESEND_WEBHOOK_SECRET=
APP_URL=http://localhost:3000
UNSUBSCRIBE_SECRET=                # openssl rand -base64 32

# ── Maps ──
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Provider selection (auto: Amadeus if credentials exist, otherwise keyless mock data) ──
FLIGHT_PROVIDER=                   # mock | amadeus
HOTEL_PROVIDER=                    # mock | amadeus
PAYMENT_MODE=mock                  # mock = confirm instantly, no card · stripe = wait for payment webhook
NEXT_PUBLIC_PAYMENT_MODE=mock
PII_ENCRYPTION_KEY=                # base64 32 bytes (openssl rand -base64 32); required in production
